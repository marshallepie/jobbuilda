# Coordinator API URL. Browser rehearsals must use IPv4 loopback so
# `localhost` cannot resolve to an unrelated IPv6 listener.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
# Keep the Admin browser origin/ADMIN_URL as http://localhost:3002 for CORS.

# Supabase Auth (for admin users)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
